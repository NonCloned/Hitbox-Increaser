local switchKeybind = Enum.KeyCode.V

local CONFIG_FILE = "HitboxIncreaser_Settings.json"

local function loadConfig()
    if type(readfile) ~= "function" or type(isfile) ~= "function" then
        return
    end

    local success, result = pcall(function()
        if not isfile(CONFIG_FILE) then
            return nil
        end
        return HttpService:JSONDecode(readfile(CONFIG_FILE))
    end)

    if not success or type(result) ~= "table" then
        return
    end

    if type(result.hitboxesEnabled) == "boolean" then
        hitboxesEnabled = result.hitboxesEnabled
    end
    if type(result.hitboxSize) == "number" then
        hitboxSize = math.clamp(result.hitboxSize, 2, 100)
    end
    if type(result.hitboxTransparency) == "number" then
        hitboxTransparency = math.clamp(result.hitboxTransparency, 0, 1)
    end
    if type(result.rainbowEnabled) == "boolean" then
        rainbowEnabled = result.rainbowEnabled
    end

    if type(result.color) == "table"
        and type(result.color.r) == "number"
        and type(result.color.g) == "number"
        and type(result.color.b) == "number" then
        hitboxColor = Color3.fromRGB(
            math.clamp(math.floor(result.color.r), 0, 255),
            math.clamp(math.floor(result.color.g), 0, 255),
            math.clamp(math.floor(result.color.b), 0, 255)
        )
    end

    if type(result.currentKeybind) == "string" then
        local key = Enum.KeyCode[result.currentKeybind]
        if key then
            currentKeybind = key
        end
    end
    if type(result.switchKeybind) == "string" then
        local key = Enum.KeyCode[result.switchKeybind]
        if key then
            switchKeybind = key
        end
    end
end

local function saveConfig()
    if type(writefile) ~= "function" then
        return
    end

    local r = math.floor(hitboxColor.R * 255 + 0.5)
    local g = math.floor(hitboxColor.G * 255 + 0.5)
    local b = math.floor(hitboxColor.B * 255 + 0.5)

    local data = {
        hitboxesEnabled = hitboxesEnabled,
        hitboxSize = hitboxSize,
        hitboxTransparency = hitboxTransparency,
        color = { r = r, g = g, b = b },
        rainbowEnabled = rainbowEnabled,
        currentKeybind = currentKeybind.Name,
        switchKeybind = switchKeybind.Name,
    }

    pcall(function()
        writefile(CONFIG_FILE, HttpService:JSONEncode(data))
    end)
end

