local sliderDragging = false

SliderBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        sliderDragging = true
    end
end)

SliderTrack.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        sliderDragging = true
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if sliderDragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local relativeX = input.Position.X - SliderTrack.AbsolutePosition.X

        local percentage = math.clamp(
            relativeX / SliderTrack.AbsoluteSize.X,
            0,
            1
        )

        hitboxTransparency = percentage

        tween(SliderBtn, TweenFast, {
            Position = UDim2.new(percentage, -6, 0.5, -6)
        })
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        if sliderDragging then
            saveConfig()
        end
        sliderDragging = false
    end
end)

-- COLOR SETTINGS
local function updateStaticColor()
    local r = tonumber(RInput.Text) or 0
    local g = tonumber(GInput.Text) or 0
    local b = tonumber(BInput.Text) or 0

    hitboxColor = Color3.fromRGB(
        math.clamp(r, 0, 255),
        math.clamp(g, 0, 255),
        math.clamp(b, 0, 255)
    )
    saveConfig()
end

RInput.FocusLost:Connect(updateStaticColor)
GInput.FocusLost:Connect(updateStaticColor)
BInput.FocusLost:Connect(updateStaticColor)

SizeInput.FocusLost:Connect(function()
    hitboxSize = math.clamp(tonumber(SizeInput.Text) or hitboxSize, 2, 100)
    SizeInput.Text = tostring(hitboxSize)
    saveConfig()
end)

-- PLAYER EVENTS
Players.PlayerRemoving:Connect(function(player)
    originalColors[player.UserId] = nil
end)

-- RENDER LOOP
RunService.RenderStepped:Connect(function()
    if hitboxesEnabled or rainbowEnabled then
        applyHitboxSettings()
    end
end)

-- BUTTON INTERACTIONS
ToggleButton.MouseButton1Click:Connect(toggleHitboxes)

RainbowButton.MouseButton1Click:Connect(function()
    rainbowEnabled = not rainbowEnabled

    RainbowButton.Text = rainbowEnabled and "ON" or "OFF"

    tween(RainbowButton, TweenSmooth, {
        BackgroundColor3 = rainbowEnabled
            and Color3.fromRGB(45, 165, 95)
            or Color3.fromRGB(40, 42, 53)
    })

    if not rainbowEnabled then
        updateStaticColor()
    else
        saveConfig()
    end
end)

-- INITIAL STATE
updateToggleButton()
RainbowButton.Text = rainbowEnabled and "ON" or "OFF"
RainbowButton.BackgroundColor3 = rainbowEnabled
    and Color3.fromRGB(45, 165, 95)
    or Color3.fromRGB(40, 42, 53)

-- Ensure the config file exists and contains the current settings.
saveConfig()

-- Show GUI after everything is initialized
setGuiVisible(true)
