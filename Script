-- HITBOX SYSTEM
local function applyHitboxSettings()
    local currentButtonColor = rainbowEnabled
        and Color3.fromHSV(tick() % 5 / 5, 1, 1)
        or hitboxColor

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local hrp = player.Character:FindFirstChild("HumanoidRootPart")

            if hrp and hrp:IsA("BasePart") then
                if not originalColors[player.UserId] then
                    originalColors[player.UserId] = hrp.Color
                end

                if hitboxesEnabled then
                    hrp.Size = Vector3.new(hitboxSize, hitboxSize, hitboxSize)
                    hrp.Transparency = hitboxTransparency
                    hrp.CanCollide = false
                    hrp.Color = currentButtonColor
                    hrp.CastShadow = false
                else
                    hrp.Size = Vector3.new(2, 2, 1)
                    hrp.Transparency = 1
                    hrp.CanCollide = false

                    if originalColors[player.UserId] then
                        hrp.Color = originalColors[player.UserId]
                    end
                end
            end
        end
    end
end

local function toggleHitboxes()
    hitboxesEnabled = not hitboxesEnabled
    updateToggleButton()
    applyHitboxSettings()
    saveConfig()
end

