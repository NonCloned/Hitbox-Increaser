-- GUI FADE SYSTEM
local fadeObjects = {}

local function registerFadeObject(object)
    local properties = {}

    if object:IsA("Frame") or object:IsA("ScrollingFrame") then
        properties.BackgroundTransparency = object.BackgroundTransparency
    elseif object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox") then
        properties.BackgroundTransparency = object.BackgroundTransparency
        properties.TextTransparency = object.TextTransparency
    elseif object:IsA("ImageLabel") or object:IsA("ImageButton") then
        properties.BackgroundTransparency = object.BackgroundTransparency
        properties.ImageTransparency = object.ImageTransparency
    end

    if object:IsA("UIStroke") then
        properties.Transparency = object.Transparency
    end

    if next(properties) then
        fadeObjects[object] = properties
    end
end

for _, object in ipairs(MainFrame:GetDescendants()) do
    registerFadeObject(object)
end

registerFadeObject(MainFrame)

local fadeToken = 0

local function setGuiVisible(state)
    isGuiVisible = state
    fadeToken += 1

    local thisToken = fadeToken

    if state then
        MainFrame.Visible = true
        MainScale.Scale = 0.94

        for object, properties in pairs(fadeObjects) do
            if object.Parent then
                for property in pairs(properties) do
                    object[property] = 1
                end
            end
        end

        tween(MainScale, TweenBack, {
            Scale = 1
        })

        for object, properties in pairs(fadeObjects) do
            if object.Parent then
                tween(object, TweenFade, properties)
            end
        end
    else
        for object, properties in pairs(fadeObjects) do
            if object.Parent then
                local targets = {}

                for property in pairs(properties) do
                    targets[property] = 1
                end

                tween(object, TweenFade, targets)
            end
        end

        tween(MainScale, TweenFade, {
            Scale = 0.94
        }).Completed:Once(function()
            if fadeToken == thisToken and not isGuiVisible then
                MainFrame.Visible = false
                MainScale.Scale = 1
            end
        end)
    end
end

