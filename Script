-- KEYBOARD INPUT
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if input.UserInputType ~= Enum.UserInputType.Keyboard then
        return
    end

    if bindingMode then
        if input.KeyCode == Enum.KeyCode.Unknown then
            return
        end

        if bindingMode == "Open" then
            currentKeybind = input.KeyCode
            BindBtn.Text = "Key: " .. currentKeybind.Name
            saveConfig()
        elseif bindingMode == "Switch" then
            switchKeybind = input.KeyCode
            SwitchBindBtn.Text = "Key: " .. switchKeybind.Name
            saveConfig()
        end

        bindingMode = nil

        tween(BindBtn, TweenFast, {
            BackgroundColor3 = Color3.fromRGB(40, 42, 53)
        })

        tween(SwitchBindBtn, TweenFast, {
            BackgroundColor3 = Color3.fromRGB(40, 42, 53)
        })

        return
    end

    if gameProcessed then
        return
    end

    if input.KeyCode == currentKeybind then
        setGuiVisible(not isGuiVisible)
    elseif input.KeyCode == switchKeybind then
        toggleHitboxes()
    end
end)

