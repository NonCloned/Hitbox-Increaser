local function createLabel(text, yOffset, parent)
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0, 90, 0, 25)
    label.Position = UDim2.new(0, 0, 0, yOffset)
    label.BackgroundTransparency = 1
